{
  "name": "electron-openpgp-gui",
  "version": "0.0.1",
  "private": true,
  "description": "An electron + vite architecture POC",
  "author": "Lastor",
  "type": "module",
  "main": "dist-electron/electron/main/index.js",
  "scripts": {
    "lint": "oxlint",
    "typecheck": "vue-tsc -b",
    "fmt": "oxfmt --check",
    "dev": "vite",
    "build:vite": "vite build",
    "build:app": "electron-builder --config electron-builder.config.js",
    "build": "pnpm build:vite && pnpm build:app",
    "preview": "electron ."
  },
  "dependencies": {
    "@lucide/vue": "^1.37.0",
    "archiver": "^8.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "openpgp": "^6.3.1",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@openpgp/web-stream-tools": "^0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.8"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^24.18.1"
  }
}
