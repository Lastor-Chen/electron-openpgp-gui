{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.renderer.tsbuildinfo",
    "types": [
      "vite/client",
      "./src/shared/utility-bridger/window-env.d.ts",
      "./src/config-env.d.ts"
    ],
    "allowArbitraryExtensions": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "@/*": ["./src/renderer/*"],
      "@shared/*": ["./src/shared/*"],
      "@utility-bridger/*": ["./src/shared/utility-bridger/*"]
    }
  },
  "include": ["src/renderer", "src/shared/utility-bridger/vue"]
}
