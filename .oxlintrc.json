{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "builtin": true
  },
  "rules": {},
  "overrides": [
    {
      "files": ["src/renderer/**/*.{ts,vue}"],
      "plugins": ["vue"],
      "env": {
        "browser": true
      },
      "rules": {
        "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }]
      }
    },
    {
      "files": ["src/electron/**/*.ts"],
      "plugins": ["node"],
      "env": { "node": true }
    },
    {
      "files": ["vite-plugin-tsdown/**"],
      "rules": {
        "no-underscore-dangle": ["warn", { "allow": ["_vpt"] }]
      }
    }
  ],
  "ignorePatterns": ["dist*/**"]
}
